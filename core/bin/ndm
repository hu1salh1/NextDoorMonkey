#!/bin/bash
#=====================================================================
# NextDoorMonkey v4.0 - Central Management Core
#=====================================================================

NDM_ROOT="/opt/nextdoormonkey"
NDM_CONFIG="/etc/ndm"
NDM_MODULES="$NDM_ROOT/core/modules"
NDM_ENABLED="$NDM_MODULES/enabled"

# Загрузка библиотек
source "$NDM_ROOT/core/lib/config.sh"
source "$NDM_ROOT/core/lib/docker.sh"
source "$NDM_ROOT/core/lib/network.sh"
source "$NDM_ROOT/core/lib/ui.sh"

#=====================================================================
# Функции настройки
#=====================================================================
initial_setup() {
    print_header "ПЕРВОНАЧАЛЬНАЯ НАСТРОЙКА"
    
    echo -e "${CYAN}Добро пожаловать в NextDoorMonkey v4.0!${NC}"
    echo "Давайте настроим основные параметры системы."
    echo ""
    
    # Настройка имени сервера
    read -p "Введите имя сервера (Enter для пропуска): " server_name
    if [ -n "$server_name" ]; then
        set_config "SERVER_NAME" "$server_name"
    fi
    
    # Настройка IP
    current_ip=$(get_server_ip)
    read -p "IP адрес сервера [$current_ip]: " server_ip
    server_ip=${server_ip:-$current_ip}
    set_config "SERVER_IP" "$server_ip"
    
    # Настройка сети
    echo ""
    echo -e "${CYAN}Настройка сети:${NC}"
    if ask_yes_no "Включить IP forwarding?"; then
        enable_ip_forwarding
        set_config "IP_FORWARDING" "true"
    fi
    
    if ask_yes_no "Настроить firewall?"; then
        setup_firewall
        set_config "FIREWALL_ENABLED" "true"
    fi
    
    # Настройка бэкапов
    echo ""
    echo -e "${CYAN}Настройка бэкапов:${NC}"
    if ask_yes_no "Включить автоматические бэкапы?"; then
        set_config "BACKUP_ENABLED" "true"
        read -p "Количество дней хранения бэкапов [30]: " backup_days
        backup_days=${backup_days:-30}
        set_config "BACKUP_DAYS" "$backup_days"
        
        # Добавление в crontab
        (crontab -l 2>/dev/null; echo "0 2 * * * $NDM_ROOT/core/bin/ndm backup") | crontab -
        print_success "Автоматический бэкап настроен на 2:00 ежедневно"
    fi
    
    echo ""
    print_success "Первоначальная настройка завершена!"
    echo ""
    echo -e "${CYAN}Следующие шаги:${NC}"
    echo "  ndm modules list      # Посмотреть доступные модули"
    echo "  ndm modules install   # Установить модуль"
    echo "  ndm modules enable    # Включить модуль"
    echo "  ndm start all         # Запустить все сервисы"
}

setup_firewall() {
    print_info "Настройка firewall..."
    
    # Базовая настройка UFW
    ufw --force disable 2>/dev/null
    ufw default deny incoming 2>/dev/null
    ufw default allow outgoing 2>/dev/null
    ufw allow 22/tcp comment "SSH" 2>/dev/null
    
    # Открыть порты для установленных модулей
    for module in $(get_modules "enabled"); do
        local port=$(get_module_port "$module")
        if [ -n "$port" ] && [ "$port" != "0" ]; then
            ufw allow "$port/tcp" comment "$module" 2>/dev/null
            print_info "Открыт порт $port для модуля $module"
        fi
    done
    
    ufw --force enable 2>/dev/null
    print_success "Firewall настроен"
}

configure_system() {
    print_header "НАСТРОЙКА ПАРАМЕТРОВ"
    
    echo -e "${CYAN}Текущие параметры:${NC}"
    echo "  SERVER_NAME: $(get_config SERVER_NAME)"
    echo "  SERVER_IP: $(get_config SERVER_IP)"
    echo "  IP_FORWARDING: $(get_config IP_FORWARDING)"
    echo "  FIREWALL_ENABLED: $(get_config FIREWALL_ENABLED)"
    echo "  BACKUP_ENABLED: $(get_config BACKUP_ENABLED)"
    echo "  BACKUP_DAYS: $(get_config BACKUP_DAYS)"
    echo ""
    
    local param=$(ask_input "Введите параметр для изменения (или Enter для выхода)")
    if [ -n "$param" ]; then
        local value=$(ask_input "Новое значение для $param")
        set_config "$param" "$value"
        print_success "$param обновлен"
        configure_system
    fi
}

configure_ports() {
    print_header "НАСТРОЙКА ПОРТОВ"
    
    for module in $(get_modules "enabled"); do
        local current_port=$(get_module_port "$module")
        echo -e "${CYAN}Модуль $module:${NC} текущий порт $current_port"
        local new_port=$(ask_port "$module" "$current_port")
        if [ "$new_port" != "$current_port" ]; then
            save_module "$module" "1" "$new_port" ""
            print_success "Порт для $module изменен на $new_port"
        fi
    done
    
    echo ""
    if ask_yes_no "Применить изменения и перезапустить модули?"; then
        restart_services "all"
    fi
}

#=====================================================================
# Управление модулями
#=====================================================================
install_module() {
    local module=$1
    
    if [ -z "$module" ]; then
        print_error "Укажите имя модуля"
        echo "Доступные модули: $(ls "$NDM_MODULES/available" 2>/dev/null | tr '\n' ' ')"
        return 1
    fi
    
    local module_source="$NDM_MODULES/available/$module"
    local module_target="$NDM_ENABLED/$module"
    
    if [ ! -d "$module_source" ]; then
        print_error "Модуль $module не найден"
        return 1
    fi
    
    print_info "Установка модуля $module..."
    
    # Вызов скрипта установки модуля
    if [ -f "$module_source/install.sh" ]; then
        bash "$module_source/install.sh"
    else
        # Создание директории модуля
        mkdir -p "$module_target"
        cp -r "$module_source"/* "$module_target/"
    fi
    
    # Сохранение в конфиг (по умолчанию выключен)
    if ! grep -q "^$module:" "$MODULES_CONFIG" 2>/dev/null; then
        save_module "$module" "0" "0" ""
    fi
    
    print_success "Модуль $module установлен"
    print_info "Для включения выполните: ndm modules enable $module"
}

remove_module() {
    local module=$1
    
    if [ -z "$module" ]; then
        print_error "Укажите имя модуля"
        return 1
    fi
    
    if [ ! -d "$NDM_ENABLED/$module" ]; then
        print_error "Модуль $module не установлен"
        return 1
    fi
    
    if ask_yes_no "Удалить модуль $module?"; then
        # Остановка модуля
        stop_module "$module"
        
        # Удаление директории
        rm -rf "$NDM_ENABLED/$module"
        
        # Удаление из конфига
        sed -i "/^$module:/d" "$MODULES_CONFIG"
        
        print_success "Модуль $module удален"
    fi
}

enable_module() {
    local module=$1
    
    if [ -z "$module" ]; then
        print_error "Укажите имя модуля"
        return 1
    fi
    
    local module_source="$NDM_MODULES/available/$module"
    local module_target="$NDM_ENABLED/$module"
    
    if [ ! -d "$module_source" ]; then
        print_error "Модуль $module не найден"
        return 1
    fi
    
    # Если модуль не установлен, устанавливаем
    if [ ! -d "$module_target" ]; then
        install_module "$module"
    fi
    
    # Запрос порта
    local default_port=$(grep -oP 'PORT=\K\d+' "$module_target/docker-compose.yml" 2>/dev/null || echo "0")
    local port=$(ask_port "$module" "$default_port")
    
    # Обновление конфига
    save_module "$module" "1" "$port" ""
    
    print_success "Модуль $module включен (порт: $port)"
    
    if ask_yes_no "Запустить модуль сейчас?"; then
        start_module "$module"
    fi
}

disable_module() {
    local module=$1
    
    if [ -z "$module" ]; then
        print_error "Укажите имя модуля"
        return 1
    fi
    
    if ! is_module_enabled "$module"; then
        print_warning "Модуль $module уже выключен"
        return 0
    fi
    
    if ask_yes_no "Выключить модуль $module?"; then
        stop_module "$module"
        save_module "$module" "0" "$(get_module_port "$module")" ""
        print_success "Модуль $module выключен"
    fi
}

#=====================================================================
# Управление сервисами
#=====================================================================
start_services() {
    local target=$1
    
    if [ "$target" = "all" ]; then
        for module in $(get_modules "enabled"); do
            start_module "$module"
        done
    elif [ -n "$target" ]; then
        if is_module_enabled "$target"; then
            start_module "$target"
        else
            print_error "Модуль $target не включен"
        fi
    else
        print_error "Укажите модуль или 'all'"
    fi
}

stop_services() {
    local target=$1
    
    if [ "$target" = "all" ]; then
        for module in $(get_modules "enabled"); do
            stop_module "$module"
        done
    elif [ -n "$target" ]; then
        stop_module "$target"
    else
        print_error "Укажите модуль или 'all'"
    fi
}

restart_services() {
    local target=$1
    stop_services "$target"
    sleep 2
    start_services "$target"
}

show_logs() {
    local module=$1
    
    if [ -z "$module" ]; then
        print_error "Укажите имя модуля"
        return 1
    fi
    
    local container_name="ndm-$module"
    docker logs --tail=50 -f "$container_name" 2>/dev/null || print_error "Контейнер $container_name не найден"
}

#=====================================================================
# Диагностика
#=====================================================================
system_check() {
    print_header "ПРОВЕРКА СИСТЕМЫ"
    
    # Проверка Docker
    echo -n "Docker: "
    if check_docker; then
        print_success "работает"
    else
        print_error "не работает"
    fi
    
    # Проверка сети
    echo -n "Интернет: "
    if ping -c 1 8.8.8.8 &>/dev/null; then
        print_success "доступен"
    else
        print_error "недоступен"
    fi
    
    # Проверка модулей
    echo ""
    echo -e "${CYAN}Модули:${NC}"
    for module in $(get_modules "enabled"); do
        local status=$(module_status "$module")
        echo -n "  $module: "
        if [ "$status" = "running" ]; then
            print_success "запущен"
        else
            print_error "остановлен"
        fi
    done
}

system_diagnostic() {
    print_header "ДИАГНОСТИКА"
    
    echo -e "${CYAN}Системная информация:${NC}"
    echo "  ОС: $(lsb_release -ds 2>/dev/null || echo 'Unknown')"
    echo "  Ядро: $(uname -r)"
    echo "  CPU: $(nproc) ядер"
    echo "  RAM: $(free -h | awk '/^Mem:/{print $2}')"
    echo "  Диск: $(df -h / | awk 'NR==2{print $4}') свободно"
    
    echo ""
    echo -e "${CYAN}Docker:${NC}"
    docker info 2>/dev/null | grep -E "Server Version|Total Memory" || echo "Docker не запущен"
    
    echo ""
    echo -e "${CYAN}Порты:${NC}"
    ss -tlnp 2>/dev/null | grep -E '51820|1080|8443|8080' || echo "Нет активных портов"
    
    echo ""
    echo -e "${CYAN}Конфигурация:${NC}"
    cat "$CORE_CONFIG" 2>/dev/null || echo "Конфиг не найден"
}

create_backup() {
    local backup_dir="/opt/ndm-backups"
    mkdir -p "$backup_dir"
    
    local backup_name="ndm-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
    
    print_info "Создание бэкапа: $backup_name"
    
    tar -czf "$backup_dir/$backup_name" \
        -C /opt/nextdoormonkey \
        core/config/ 2>/dev/null || true
    
    tar -czf "$backup_dir/$backup_name" \
        -C /etc/ndm \
        . 2>/dev/null || true
    
    print_success "Бэкап создан: $backup_dir/$backup_name"
    
    # Удаление старых бэкапов
    local days=$(get_config BACKUP_DAYS)
    find "$backup_dir" -name "*.tar.gz" -mtime "+${days:-30}" -delete
}

restore_backup() {
    local backup_file=$1
    
    if [ -z "$backup_file" ]; then
        print_error "Укажите файл бэкапа"
        return 1
    fi
    
    if [ ! -f "$backup_file" ]; then
        print_error "Файл $backup_file не найден"
        return 1
    fi
    
    if ask_yes_no "Восстановить из бэкапа $backup_file? Сервисы будут остановлены"; then
        stop_services "all"
        tar -xzf "$backup_file" -C /
        start_services "all"
        print_success "Восстановление завершено"
    fi
}

ask_input() {
    local prompt=$1
    local value
    read -p "$prompt: " value
    echo "$value"
}

#=====================================================================
# Обработка команд
#=====================================================================
case "$1" in
    status)
        show_status
        ;;
    info)
        show_connection_info
        ;;
    setup)
        initial_setup
        ;;
    config)
        configure_system
        ;;
    ports)
        configure_ports
        ;;
    modules)
        case "$2" in
            list)
                list_modules
                ;;
            enable)
                enable_module "$3"
                ;;
            disable)
                disable_module "$3"
                ;;
            install)
                install_module "$3"
                ;;
            remove)
                remove_module "$3"
                ;;
            *)
                echo "Usage: ndm modules {list|enable|disable|install|remove} [name]"
                ;;
        esac
        ;;
    start)
        start_services "$2"
        ;;
    stop)
        stop_services "$2"
        ;;
    restart)
        restart_services "$2"
        ;;
    logs)
        show_logs "$2"
        ;;
    check)
        system_check
        ;;
    doctor)
        system_diagnostic
        ;;
    backup)
        create_backup
        ;;
    restore)
        restore_backup "$2"
        ;;
    version)
        echo "NextDoorMonkey v4.0"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        if [ -z "$1" ]; then
            show_help
        else
            echo -e "${RED}Неизвестная команда: $1${NC}"
            echo "Используйте 'ndm help' для справки"
            exit 1
        ;;
esac